    ; click
    ENTER 0 0
    ; label 103
    LAB.v 49200
    DROP
    LAB.v 49200
    DROP
    LEAVE 0

    ; touch
    ENTER 0 0
    ; label 103
    LEAVE 0

    ; clear
    ENTER 0 0
    ; label 103
    CN 0
    SAB.v 49168
    CN 0
    SAB.v 49168
    LEAVE 0

    ; poke
    ENTER 4 2
    ; label 103
    LLB 2
    LLW 0
    SB.v
    LEAVE 4

    ; pokew
    ENTER 4 2
    ; label 103
    CN 5
    LLW 0
    IDXLW 2
    SW.v
    LEAVE 4

    ; tone
    ENTER 4 1
    ; label 103
    LLW 0
    CN 0
    BRNCH 1
    ; label 0
    DLW 2
    LAB.v 49200
    DROP
    INCR
    ; label 1
    BRLT 0
    DROP2
    LEAVE 4

    ; spin
    ENTER 4 1
    ; label 103
    LLW 0
    CN 0
    BRNCH 1
    ; label 0
    DLW 2
    INCR
    ; label 1
    BRLT 0
    DROP2
    LEAVE 4

    ; voctal
    ENTER 0 0
    ; label 103
    LAB.v 49152
    CB 176
    ISGE
    BRFLS 0
    LAB.v 49152
    CB 183
    ISLE
    BRFLS 0
    CN 1
    LEAVE 0
    ; label 0
    CN 0
    ; label 1
    LEAVE 0

    ; octal
    ENTER 2 1
    ; label 103
    LLB 0
    ANDI 248
    CB 48
    ISEQ
    NEG
    LEAVE 2

    ; vstore
    ENTER 0 0
    ; label 103
    CN 3
    SAW.v data +6
    LAW.v data +6
    LEAVE 0

    ; store
    ENTER 0 0
    ; label 103
    CN 3
    DAW data +8
    LEAVE 0

    ; vbump
    ENTER 0 0
    ; label 103
    LAW.v data +6
    ADDI 2
    SAW.v data +6
    LAW.v data +6
    DUP
    INCR
    SAW.v data +6
    LEAVE 0

    ; vlocal
    ENTER 2 0
    ; label 103
    CN 5
    SLW.v 0
    CN 6
    SLW.v 0
    CN 1
    LEAVE 2

    ; local
    ENTER 2 0
    ; label 103
    CN 1
    LEAVE 2

    ; vwait
    ENTER 2 0
    ; label 103
    CN 0
    SLW 0
    BRNCH 1
    ; label 0
    LLW 0
    INCR
    SLW 0
    ; label 1
    LAW.v data +6
    BRTRU 0
    LLW 0
    LEAVE 2

    ; main
    ENTER 1 0
    ; label 103
    CN 0
    SLB 0
    CALL click
    CALL touch
    CALL clear
    LLA 0
    CN 7
    CALL poke
    LA data +8
    CN 0
    CALL pokew
    CN 3
    CALL tone
    CN 3
    CALL spin
    CALL voctal
    DROP
    LLB 0
    CN 7
    BRNE 1
    CB 53
    CALL octal
    BRFLS 3
    ; join 1 to 3
    ; label 2
    CB 56
    CALL octal
    BRFLS 4
    ; join 4 to 0
    ; label 3
    CN 1
    LEAVE 1
    ; label 0
    LAW data +8
    CN 5
    BREQ 5
    CN 3
    LEAVE 1
    ; label 5
    CALL vstore
    CN 3
    BRNE 7
    CALL store
    CN 3
    BRNE 9
    ; join 7 to 9
    ; label 8
    CALL vbump
    CN 5
    BRNE 11
    ; join 9 to 11
    ; label 10
    LAW.v data +6
    CN 6
    BREQ 12
    ; join 12 to 6
    ; label 11
    CN 2
    LEAVE 1
    ; label 6
    CN 0
    SAW.v data +6
    CALL vlocal
    CALL local
    ADD
    CALL vwait
    ADD
    SUBI 2
    LEAVE 1
