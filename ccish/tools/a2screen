#!/bin/sh
# a2screen: boot a ProDOS disk image on an emulated 64K Apple IIe in
# MAME, and print its 40-column text screen after some seconds of
# emulated time. For measuring PLASMA on a 64K machine (approach.md,
# "Free memory, measured"), and later for running ccish's programs.
#
# Usage: tools/a2screen ROMDIR DISK.po [SECONDS]
#
# ROMDIR holds MAME's ROM sets for the enhanced IIe (apple2ee, in
# apple2e.zip) and its default cards (a2diskiing.zip, d2fdc.zip and
# votrsc01a.zip); "mame -verifyroms apple2ee -rompath ROMDIR" checks
# them. The machine is an enhanced IIe with no 80-column card (so 64K,
# and a 40-column screen in main memory), with MAME's default cards:
# the Disk II controller in slot 6.
#
# It never touches the desktop: SDL's dummy drivers and no input
# providers, so MAME opens no window and takes no keyboard or mouse.
# It always ends: MAME's own -seconds_to_run, the Lua script's exit,
# and a timeout behind both.
set -eu
[ $# -ge 2 ] || { echo "usage: $0 ROMDIR DISK.po [SECONDS]" >&2; exit 2; }
romdir=$1
disk=$2
after=${3:-20}
here=$(dirname "$0")

A2SCREEN_AFTER=$after SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
  timeout $((after + 40)) mame apple2ee -rompath "$romdir" \
  -aux "" -flop1 "$disk" \
  -video none -sound none -keyboardprovider none -mouseprovider none \
  -joystickprovider none -lightgunprovider none \
  -nothrottle -skip_gameinfo -seconds_to_run $((after + 5)) \
  -autoboot_script "$here/a2screen.lua" 2>&1 \
  | grep -v '^ *$'
