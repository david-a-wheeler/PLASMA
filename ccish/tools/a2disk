#!/bin/sh
# a2disk: make the Apple II disks that run ccish on a 64K Apple II,
# through XLOAD (doc/xload.md), in tests/out/apple:
#   ccish.po  volume CCISH: XLOAD (a REL module), ccish's four passes as
#             XLOAD images (ccrel -x, from tools/measure.py's objects,
#             the small build's), and CCISH.MSG: about 108K of the 140K
#   cclib.po  volume CCLIB: the C library's objects in LIB/ (link a
#             program with LIB/START and the rest, as tools/cclink
#             names them), with room for a program's own files: its
#             own disk, since 42 small files take about 21K
#   boot.po   samples/boot.po (PLASMA 2.20, stopping at its prompt) with
#             the C library's headers in SYS/CCINC, where ccpp looks
#             for <...> on an Apple II (<syspath>ccinc)
# Run make (and so tools/measure.py) and make xload first.
#
# Usage: tools/a2disk
# Then, e.g., with CCLIB the prefix, so that a program's files go there:
#   A2CMD_DISK3=tests/out/apple/cclib.po tools/a2cmd ../mame \
#     tests/out/apple/boot.po tests/out/apple/ccish.po 30 "P /CCLIB" \
#     "+/CCISH/XLOAD /CCISH/CCPP T.C" ...
# (run by its path, a pass finds CCISH.MSG beside it).
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"
AC=../bin/ac-linux-aarch64-15.2
out=tests/out/apple
mkdir -p "$out/obj"
for f in tools/out/ccpp.objs tests/out/xload/xload samples/boot.po; do
    [ -f "$f" ] || { echo "a2disk: no $f (make, make xload)" >&2; exit 1; }
done

# The four images, from the objects measure.py linked.
for p in ccpp cccomp ccgen ccrel; do
    while read -r o; do
        cp "$o.obj" "$o.syms" "$out/obj/"
        basename "$o"
    done <"tools/out/$p.objs" >"$out/obj/$p.list"
    (cd "$out/obj" && "$here/ccrel-small" -x -o "../$p" "@$p.list")
done

# The compiler's disk. AppleCommander won't overwrite a disk image.
[ ! -e "$out/ccish.po" ] || mv -f "$out/ccish.po" "$out/ccish.po.old"
$AC -pro140 "$out/ccish.po" CCISH
$AC -p "$out/ccish.po" XLOAD REL <tests/out/xload/xload
for p in ccpp cccomp ccgen ccrel; do
    $AC -p "$out/ccish.po" "$(echo $p | tr a-z A-Z)" BIN <"$out/$p"
done
$AC -p "$out/ccish.po" CCISH.MSG TXT <ccish.msg

# The library's disk.
[ ! -e "$out/cclib.po" ] || mv -f "$out/cclib.po" "$out/cclib.po.old"
$AC -pro140 "$out/cclib.po" CCLIB
for o in tests/out/lib/*.obj; do
    n=$(basename "$o" .obj | tr a-z A-Z)
    $AC -p "$out/cclib.po" "LIB/$n.OBJ" BIN <"$o"
    $AC -p "$out/cclib.po" "LIB/$n.SYMS" BIN <"${o%.obj}.syms"
done

# The boot disk, with the headers.
cp samples/boot.po "$out/boot.po"
for h in lib/include/*.h; do
    $AC -p "$out/boot.po" "SYS/CCINC/$(basename "$h" | tr a-z A-Z)" TXT <"$h"
done
for d in ccish cclib boot; do
    echo "$d.po: $($AC -l "$out/$d.po" | grep "bytes free")"
done
