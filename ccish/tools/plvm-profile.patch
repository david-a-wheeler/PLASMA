+#ifdef PLVM_PROFILE
+#define PROFILE_MODULES 64
+static struct {
+    char name[18];
+    code *start;
+    int len;
+    unsigned long *count;
+} profile_mod[PROFILE_MODULES];
+static int profile_nmods, profile_last;
+static unsigned long profile_other;
+
+/*
+ * Note a module's bytecode, once it is copied to where it runs.
+ */
+void profile_module(const char *name, code *bytecode, int len)
+{
+    if (profile_nmods < PROFILE_MODULES && len > 0)
+    {
+        strncpy(profile_mod[profile_nmods].name, name, 17);
+        profile_mod[profile_nmods].start = bytecode;
+        profile_mod[profile_nmods].len   = len;
+        profile_mod[profile_nmods].count = calloc(len, sizeof(unsigned long));
+        if (profile_mod[profile_nmods].count)
+            profile_nmods++;
+    }
+}
+
+/*
+ * Count the op at ip: in the module last counted, most likely.
+ */
+static void profile_op(code *ip)
+{
+    int m = profile_last;
+    if (m < profile_nmods && ip >= profile_mod[m].start
+        && ip < profile_mod[m].start + profile_mod[m].len)
+    {
+        profile_mod[m].count[ip - profile_mod[m].start]++;
+        return;
+    }
+    for (m = 0; m < profile_nmods; m++)
+        if (ip >= profile_mod[m].start && ip < profile_mod[m].start + profile_mod[m].len)
+        {
+            profile_mod[m].count[ip - profile_mod[m].start]++;
+            profile_last = m;
+            return;
+        }
+    profile_other++;
+}
+
+/*
+ * Write the counts to the file PLVM_PROFILE names, if it names one.
+ */
+void profile_write(void)
+{
+    const char *path = getenv("PLVM_PROFILE");
+    FILE *f;
+    int m, i;
+    if (!path || !(f = fopen(path, "w")))
+        return;
+    for (m = 0; m < profile_nmods; m++)
+    {
+        fprintf(f, "module %s %d\n", profile_mod[m].name, profile_mod[m].len);
+        for (i = 0; i < profile_mod[m].len; i++)
+            if (profile_mod[m].count[i])
+                fprintf(f, "%d %lu\n", i, profile_mod[m].count[i]);
+    }
+    fprintf(f, "other %lu\n", profile_other);
+    fclose(f);
+}
+#endif
+
 void vm_interp(M6502 *mpu, code *vm_ip)
 {
     int val, ea, frmsz, parmcnt;
