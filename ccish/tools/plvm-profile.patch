+ * Profiling, in a plvm built with -DPLVM_PROFILE (a normal build has
+ * none of it): count the ops run at each offset of each module's
+ * bytecode, and at exit, if the environment variable PLVM_PROFILE names
+ * a file, write the counts there: for each module, a line
+ * "module NAME LENGTH", then a line "OFFSET COUNT" for each offset that
+ * ran; and last, "other COUNT", the ops run outside any module's
+ * bytecode.
+ */
+extern void profile_module(const char *name, code *bytecode, int len);
+extern void profile_write(void);
+#endif
