#!/bin/sh
# a2cmd: run commands at PLASMA's prompt on an emulated Apple IIe in
# MAME, and print the text screen afterwards. It boots
# BOOT.po (a PLASMA boot disk that stops at its prompt, showing its
# "MEM FREE:" line) with DISK2.po in the second drive, types each
# COMMAND with a Return, each when CMD's prompt is back (or after
# A2CMD_GAP seconds of emulated time, 3600 if unset), prints how long
# each took, and prints the screen when the prompt is back after the
# last. For running ccish's programs and XLOAD (doc/xload.md) on
# a 64K machine, or a 128K one.
#
# With A2CMD_128K set, the IIe has 128K (an extended 80-column card),
# so PLASMA runs its 128K VM, with the bytecode in aux memory.
#
# With A2CMD_DISK3 set to a disk image, a second Disk II controller
# goes in slot 5, with that disk in its first drive. (MAME then numbers
# slot 5's drives first: flop1 and flop2 are slot 5's, flop3 and flop4
# slot 6's, which the IIe boots.)
#
# Usage: tools/a2cmd ROMDIR BOOT.po DISK2.po COMMAND...
# e.g.:  tools/a2cmd ROMDIR samples/boot.po xl.po "P /XL" "+XLOAD HELLO"
#
# The machine and ROMDIR are tools/a2screen's, as are the guards: it
# never touches the desktop (SDL's dummy drivers, no input providers)
# and always ends (-seconds_to_run, the script's exit, and a timeout).
set -eu
[ $# -ge 4 ] || {
  echo "usage: $0 ROMDIR BOOT.po DISK2.po COMMAND..." >&2; exit 2; }
romdir=$1
boot_disk=$2
disk2=$3
shift 3
here=$(dirname "$0")
gap=${A2CMD_GAP:-3600}
boot=${A2CMD_BOOT:-60}  # emulated seconds allowed for booting to the prompt
cmds=
for c in "$@"; do
  cmds="$cmds$c|"
done
run_for=$((boot + gap * ($# + 1) + 10))
# The commands are in $cmds now, so the positional parameters can hold
# the aux slot's options: 64K, no 80-column card's aux memory; 128K,
# MAME's default, the extended 80-column card.
if [ -n "${A2CMD_128K:-}" ]; then set --; else set -- -aux ""; fi
drives="-flop1 $boot_disk -flop2 $disk2"
if [ -n "${A2CMD_DISK3:-}" ]; then
  drives="-sl5 diskiing -flop3 $boot_disk -flop4 $disk2 -flop1 $A2CMD_DISK3"
fi

A2CMD_CMDS=$cmds A2CMD_GAP=$gap A2CMD_BOOT=$boot \
  SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
  timeout $((run_for + 60)) mame apple2ee -rompath "$romdir" \
  "$@" $drives \
  -video none -sound none -keyboardprovider none -mouseprovider none \
  -joystickprovider none -lightgunprovider none \
  -nothrottle -skip_gameinfo -seconds_to_run "$run_for" \
  -autoboot_script "$here/a2cmd.lua" 2>&1 \
  | grep -v '^ *$'
