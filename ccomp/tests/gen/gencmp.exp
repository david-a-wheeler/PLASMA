    ; eq
    ENTER 4 2
    LLW 0
    LLW 2
    ISEQ
    NEG
    LEAVE 4

    ; ne
    ENTER 4 2
    LLW 0
    LLW 2
    ISNE
    NEG
    LEAVE 4

    ; isz
    ENTER 2 1
    LLW 0
    CN 0
    ISEQ
    NEG
    LEAVE 2

    ; nz
    ENTER 2 1
    LLW 0
    CN 0
    ISNE
    NEG
    LEAVE 2

    ; ngt
    ENTER 4 2
    LLW 0
    LLW 2
    ISGT
    NEG
    NOT
    ANDI 1
    LEAVE 4

    ; negx
    ENTER 2 1
    LLW 0
    NEG
    CN 0
    ISNE
    NEG
    LEAVE 2

    ; notx
    ENTER 2 1
    LLW 0
    NOT
    ANDI 1
    LEAVE 2

    ; iint
    ENTER 2 1
    LLW 0
    CN 0
    ISNE
    NEG
    LEAVE 2

    ; tret
    ENTER 2 1
    LLW 0
    CN 0
    ISNE
    NEG
    LEAVE 2

    ; tsw
    ENTER 2 1
    LLW 0
    CN 0
    ISEQ
    NEG
    LEAVE 2

    ; tsame
    ENTER 2 1
    CN 5
    LEAVE 2

    ; tadd
    ENTER 4 2
    LLW 2
    LLW 0
    CN 0
    ISNE
    NEG
    ADD
    LEAVE 4

    ; andv
    ENTER 4 2
    LLW 0
    BRFLS 0
    LLW 2
    BRFLS 0
    CN 1
    BRNCH 1
    ; label 0
    CN 0
    ; label 1
    LEAVE 4

    ; orv
    ENTER 4 2
    LLW 0
    BRTRU 0
    LLW 2
    BRFLS 1
    ; label 0
    CN 1
    BRNCH 2
    ; label 1
    CN 0
    ; label 2
    LEAVE 4

    ; main
    ENTER 0 0
    CN 1
    CN 1
    CALL eq
    DROP
    CN 1
    CN 1
    CALL ne
    DROP
    CN 0
    CALL isz
    DROP
    CN 0
    CALL nz
    DROP
    CN 1
    CN 1
    CALL ngt
    DROP
    CN 0
    CALL negx
    DROP
    CN 0
    CALL notx
    DROP
    CN 3
    CALL iint
    DROP
    CN 3
    CALL tret
    DROP
    CN 3
    CALL tsw
    DROP
    CN 3
    CALL tsame
    DROP
    CN 3
    CN 10
    CALL tadd
    DROP
    CN 1
    CN 1
    CALL andv
    DROP
    CN 0
    CN 1
    CALL orv
    DROP
    CN 0
    LEAVE 0
