    ; foldpair
    ENTER 2 1
    ; label 103
    LLW 0
    ANDI 240
    LEAVE 2

    ; foldthree
    ENTER 2 1
    ; label 103
    LLW 0
    ANDI 192
    LEAVE 2

    ; nofold
    ENTER 2 1
    ; label 103
    LLB 0
    ANDI 240
    LEAVE 2

    ; main
    ENTER 0 0
    ; label 103
    CW 300
    CALL foldpair
    DROP
    CW 500
    CALL foldthree
    DROP
    CB 97
    CALL nofold
    DROP
    CN 0
    LEAVE 0
