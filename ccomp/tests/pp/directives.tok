# Object-like macros, conditional groups, a joined line, the null
# directive and #pragma (CCPP.md; approach.md, "ccpp design", step 4).
# Lines 1-3 define N (id 32), S (33) and E (34), and write nothing.
43 54 4b 02     # "CTK", version 2
01 01 01        # up to line 4: 3 lines, so next-line codes
# line 4: int x = N;
80
04 23 00        # x: id 35
3d
05 2a 00        # N: 42
3b
01
# line 5: S tag *p;  S is struct, so tag is a struct's tag
87
09 24 00 9a bf 5f 74    # tag: id 36; its hash is 49050 ($BF9A), 31^3 = 29791 ($745F)
2a
04 25 00        # p: id 37
3b
01 01           # line 6 is #ifdef N, which is defined
# line 7: int y E;  E is empty
80
04 26 00        # y: id 38
3b
# lines 8-17 are skipped or directives; "don't lex this", "skipped" and
# "no" are never split into tokens, so they get no ids
02 12 00        # up to line 18: 11 lines, so a jump
# lines 18-19, joined by the backslash: int z = 1;
80
04 27 00        # z: id 39
3d
05 01 00
3b
# line 20 is a null directive, and line 21's #pragma is ignored, but its
# names get ids: anything (40), here (41)
02 16 00        # up to line 22: 4 lines, so a jump
04 2a 00        # q: id 42
3b
01              # the end is on line 23
00 2a 00 ss ss  # the end: 42 ids, the checksum
