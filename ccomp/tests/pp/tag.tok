# A struct tag (CCPP.md, $09): an identifier after "struct", with its
# spelling's hash h (each byte b: h = h * 31 + b, from 0) and 31^length.
43 54 4b 01     # "CTK", version 1
8f              # struct
09 1c 00 73 00 1f 00    # s: id 28, h = 's' = 115, 31^1 = 31
2a
04 1d 00        # p: id 29, not a tag
3b
01
8f              # struct
01              # a newline between it and the tag
09 1e 00 21 0c c1 03    # ab: id 30, h = 97 * 31 + 98 = 3105, 31^2 = 961
3b
01
00 1e 00 ss ss  # the end: 30 ids, the checksum
